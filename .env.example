# 인증 스택 환경변수 템플릿. 복사해서 .env로 쓴다: cp .env.example .env
# 주의: COMPOSE_PROJECT_NAME은 넣지 않는다(compose의 name: sandol-auth를 덮어쓴다).

# --- 전환 기간 전용: 같은 서버에서 루트와 함께 띄울 때 colocated 오버라이드를 항상 적용한다.
# 새 서버에서 단독 기동할 때는 이 줄을 제거(주석 처리)한다.
COMPOSE_FILE=docker-compose.yml:docker-compose.colocated.yml

# --- 단독 기동(새 서버) 시 keycloak 8080·auth-relay 8000을 publish할 호스트 주소. 기본 루프백(외부 노출 없음).
# 별도 서버로 분리하면 메인 서버와 통신하는 사설 IP로 바꾼다. 방화벽에서 8080·8000은 메인 서버 IP만 허용한다.
AUTH_BIND_ADDR=127.0.0.1

# --- Keycloak 공개 주소(경로 /auth 포함). issuer가 이 값으로 정해진다. 예: https://<도메인>/auth
KC_PUBLIC_URL=https://sandori.kr/auth
# --- Keycloak DB 계정 (기존 DB를 이어 쓸 때는 기존 값과 같아야 한다)
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
# --- Keycloak 최초 기동 시 부트스트랩 관리자(기존 realm에서는 무시됨)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# --- postgres-exporter 계정 비밀번호 (scripts/create-pg-exporter-role.sh로 계정 생성)
PG_EXPORTER_PASSWORD=

# --- 데이터 경로: auth-relay clients.json(${SANDOL_DATA_DIR}/auth-relay/clients.json), 백업 기본 위치
SANDOL_DATA_DIR=/home/ubuntu/data/sandol
# 백업 위치를 따로 둘 때만. 기본: ${SANDOL_DATA_DIR}/backups-auth
SANDOL_AUTH_BACKUP_DIR=
# 보관할 백업 디렉터리 개수. 초과분은 오래된 것부터 삭제
BACKUP_KEEP=10
# auth-relay 이미지 태그
TAG=latest

# --- Keycloak 볼륨 이름. 기존 루트 프로젝트 볼륨에 붙을 때 `docker volume ls`의 실제 이름과 맞춘다.
# 기본값은 루트 COMPOSE_PROJECT_NAME=sandol_team 기준. 새 서버에서 새로 시작하면 기본값 그대로 두어도 된다.
KEYCLOAK_DB_VOLUME=sandol_team_keycloak_db_data
KEYCLOAK_DATA_VOLUME=sandol_team_keycloak_data

# --- colocated(같은 서버 전환 기간)에서만 사용
# 루트가 만든 네트워크 실제 이름(`docker network ls`). 루트 COMPOSE_PROJECT_NAME 접두사가 붙는다.
SANDOL_NETWORK_NAME=sandol_team_sandol_network
KEYCLOAK_EDGE_NETWORK_NAME=sandol_keycloak_edge
# 루트 keycloak_edge 서브넷과 같은 값(KC_PROXY_TRUSTED_ADDRESSES)
KEYCLOAK_EDGE_SUBNET=172.31.255.248/29
